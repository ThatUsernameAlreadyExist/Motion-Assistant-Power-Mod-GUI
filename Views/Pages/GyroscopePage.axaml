<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="using:PmGui.Helpers"
             xmlns:models="using:PmGui.Models"
             x:Class="PmGui.Views.Pages.GyroscopePage">
    
    <StackPanel Margin="40,16">
        
        <TextBlock Text="{Binding $parent[Window].DataContext.Localization[GyroscopeSettings]}" 
                   Classes="settings-title"/>

        <!-- Gyroscope Controls -->
        <Border Classes="settings-card"
                DataContext="{Binding $parent[Window].DataContext}">
            <StackPanel Spacing="16">
                
                <!-- Enable Gyroscope -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Localization[EnableGyroscope]}" 
                                   FontWeight="Medium"
                                   FontSize="14"/>
                        <TextBlock Text="{Binding Localization[EnableGyroscopeDescription]}" 
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                                  IsChecked="{Binding GyroscopePageViewModel.EnableGyroscope, Mode=TwoWay}"
                                  IsEnabled="{Binding $parent[Window].DataContext.GyroscopePageViewModel.IsReadOnlyEnableGyroscope, Converter={StaticResource InvertBooleanConverter}}"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Right"/>
                </Grid>
                
        <!-- Gyroscope Activation Button -->
                <Separator Background="{DynamicResource BorderBrush}"
                           IsVisible="{Binding GyroscopePageViewModel.IsGyroscopeActivationButtonVisible}"/>
                
                <Grid ColumnDefinitions="*,Auto"
                      IsVisible="{Binding GyroscopePageViewModel.IsGyroscopeActivationButtonVisible}">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Localization[GyroscopeActivationButton]}" 
                                   FontWeight="Medium"
                                   FontSize="14"/>
                        <TextBlock Text="{Binding Localization[GyroscopeActivationButtonTip]}" 
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding GyroscopePageViewModel.GyroscopeActivationButtonItems}"
                              SelectedItem="{Binding GyroscopePageViewModel.GyroscopeActivationButtonSelectedItem, Mode=TwoWay}"
                              IsEnabled="{Binding $parent[Window].DataContext.GyroscopePageViewModel.IsReadOnlyGyroscopeActivationButton, Converter={StaticResource InvertBooleanConverter}}"
                              HorizontalAlignment="Right"
                              Width="240"
                              VerticalAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <!-- Gyroscope Sensitivity Slider -->
                <Separator Background="{DynamicResource BorderBrush}"
                    IsVisible="{Binding GyroscopePageViewModel.EnableGyroscope}"/>
                
                <StackPanel Spacing="8"
                    IsVisible="{Binding GyroscopePageViewModel.EnableGyroscope}">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Localization[GyroscopeSensitivity]}" 
                                       FontWeight="Medium"
                                       FontSize="14"/>
                            <TextBlock Text="{Binding Localization[GyroscopeSensitivityDescription]}" 
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" 
                                   Text="{Binding GyroscopePageViewModel.GyroscopeSensitivity, StringFormat='{}{0:0.0}'}" 
                                   FontSize="14" 
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    
                    <Slider Minimum="{Binding GyroscopePageViewModel.GyroscopeSensitivityMin}"
                            Maximum="{Binding GyroscopePageViewModel.GyroscopeSensitivityMax}"
                            Value="{Binding GyroscopePageViewModel.GyroscopeSensitivity, Mode=TwoWay}"
                            TickFrequency="0.5"
                            IsSnapToTickEnabled="True"
                            models:SliderKeyboardBehavior.DebouncedCommand="{Binding GyroscopePageViewModel.SendCmdGyroscopeSensitivityCommand}"
                            IsEnabled="{Binding $parent[Window].DataContext.GyroscopePageViewModel.IsReadOnlyGyroscopeSensitivity, Converter={StaticResource InvertBooleanConverter}}"/>
                </StackPanel>
                
                <!-- High Precision Gyroscope -->
                <Grid ColumnDefinitions="*,Auto"
                    IsVisible="{Binding GyroscopePageViewModel.EnableGyroscope}">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Localization[HighPrecisionGyroscope]}" 
                                   FontWeight="Medium"
                                   FontSize="14"/>
                        <TextBlock Text="{Binding Localization[HighPrecisionGyroscopeDescription]}" 
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                                  IsChecked="{Binding GyroscopePageViewModel.HighPrecisionGyroscope, Mode=TwoWay}"
                                  IsEnabled="{Binding $parent[Window].DataContext.GyroscopePageViewModel.IsReadOnlyHighPrecisionGyroscope, Converter={StaticResource InvertBooleanConverter}}"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Right"
                                  OnContent=""
                                  OffContent=""/>
                </Grid>
                
                <!-- Swap X and Y Axis -->
                <Grid ColumnDefinitions="*,Auto"
                    IsVisible="{Binding GyroscopePageViewModel.EnableGyroscope}">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Localization[SwapXandYAxis]}" 
                                   FontWeight="Medium"
                                   FontSize="14"/>
                        <TextBlock Text="{Binding Localization[SwapXandYAxisDescription]}" 
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                                  IsChecked="{Binding GyroscopePageViewModel.SwapXandYAxis, Mode=TwoWay}"
                                  IsEnabled="{Binding $parent[Window].DataContext.GyroscopePageViewModel.IsReadOnlySwapXandYAxis, Converter={StaticResource InvertBooleanConverter}}"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Right"/>
                </Grid>
                
                <!-- Invert X Axis -->
                <Grid ColumnDefinitions="*,Auto"
                    IsVisible="{Binding GyroscopePageViewModel.EnableGyroscope}">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Localization[InvertXAxis]}" 
                                   FontWeight="Medium"
                                   FontSize="14"/>
                        <TextBlock Text="{Binding Localization[InvertXAxisDescription]}" 
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                                  IsChecked="{Binding GyroscopePageViewModel.InvertXAxis, Mode=TwoWay}"
                                  IsEnabled="{Binding $parent[Window].DataContext.GyroscopePageViewModel.IsReadOnlyInvertXAxis, Converter={StaticResource InvertBooleanConverter}}"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Right"/>
                </Grid>
                
                <!-- Invert Y Axis -->
                <Grid ColumnDefinitions="*,Auto"
                    IsVisible="{Binding GyroscopePageViewModel.EnableGyroscope}">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Localization[InvertYAxis]}" 
                                   FontWeight="Medium"
                                   FontSize="14"/>
                        <TextBlock Text="{Binding Localization[InvertYAxisDescription]}" 
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                                  IsChecked="{Binding GyroscopePageViewModel.InvertYAxis, Mode=TwoWay}"
                                  IsEnabled="{Binding $parent[Window].DataContext.GyroscopePageViewModel.IsReadOnlyInvertYAxis, Converter={StaticResource InvertBooleanConverter}}"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Right"/>
                </Grid>
                
                <Separator Background="{DynamicResource BorderBrush}"/>
                
                <!-- Disable Bosch Accelerometer -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Localization[DisableBoschAccelerometer]}" 
                                   FontWeight="Medium"
                                   FontSize="14"/>
                        <TextBlock Text="{Binding Localization[DisableBoschAccelerometerDescription]}" 
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                                  IsChecked="{Binding GyroscopePageViewModel.DisableBoschAccelerometer, Mode=TwoWay}"
                                  IsEnabled="{Binding $parent[Window].DataContext.GyroscopePageViewModel.IsReadOnlyDisableBoschAccelerometer, Converter={StaticResource InvertBooleanConverter}}"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Right"/>
                </Grid>
                

                
            </StackPanel>
        </Border>
        
    </StackPanel>
</UserControl>
